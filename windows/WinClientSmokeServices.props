<Project>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Skybridge.WinClient/Services/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Skybridge.WinClient/Converters/*.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Skybridge.WinClient/Resources/qperiapt-production-trust-root.json" LogicalName="Skybridge.QPeriapt.ProductionTrustRoot.json" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Skybridge.WinClient/Resources/account-device-apple-models.json" LogicalName="Skybridge.AccountDevices.AppleModels.json" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" PrivateAssets="all" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>
</Project>
